{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Einrichtungsplaner WE 13",
  "version": "2.3.0",
  "identifier": "de.mlurz92.einrichtungsplaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Einrichtungsplaner WE 13",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 720,
        "maximized": true,
        "dragDropEnabled": false,
        "transparent": true,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#ece8e1"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.github.com data: blob:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob: data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "2D/3D-Einrichtungsplaner Wohnung WE 13",
    "longDescription": "Maßstabsgetreue Möblierung und Gestaltung der Wohnung WE 13 mit Katalog (Westwing, IKEA, JYSK, Tylko, lampe.de), den vier Möblierungskonzepten und freier Gestaltung von Grund auf.",
    "copyright": "© 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "German"
        ],
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "sidebarImage": "icons/installer-sidebar.bmp",
        "headerImage": "icons/installer-header.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": "de-DE"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "we13"
        ],
        "name": "Einrichtungsprojekt WE 13",
        "description": "Projekt des Einrichtungsplaners WE 13",
        "role": "Editor",
        "mimeType": "application/x-einrichtungsplaner-we13"
      }
    ]
  }
}
