{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Berechtigungen des Hauptfensters: Fenstertitel und Schließen-Abfrage, Datei-Dialoge, Lesen/Schreiben vom Nutzer gewählter Dateien, Shop-Links im Browser öffnen",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    { "identifier": "fs:scope", "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$PICTURE/**" }, { "path": "**" }] },
    "opener:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }] }
  ]
}
